.user-detail-page {
  min-height: 100vh;
  padding: 0;
}

.user-summary {
  padding: 48rpx 32rpx;
  text-align: center;
}

.avatar {
  display: block;
  width: 160rpx;
  height: 160rpx;
  margin: 0 auto;
  border-radius: 50%;
  background: #f1f1f1;
}

.user-name {
  margin-top: 20rpx;
  color: #333333;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.5;
}

.introduction,
.user-email {
  margin-top: 8rpx;
  color: #888888;
  font-size: 26rpx;
  line-height: 1.6;
}

.user-meta {
  display: flex;
  justify-content: center;
  margin-top: 20rpx;
}

.user-state {
  padding: 120rpx 48rpx;
  color: #888888;
  text-align: center;
}

.user-state__message {
  line-height: 1.6;
}

.retry-button {
  width: 240rpx;
  margin-top: 32rpx;
}