<view class="page profile-edit-page">
  <view class="page__bd">
    <view class="avatar-wrap">
      <image
        class="avatar {{uploadingAvatar ? 'avatar_uploading' : ''}}"
        mode="aspectFill"
        src="{{form.avatar || '/assets/images/user.png'}}"
        bindtap="selectAvatar"
      />
      <view class="avatar-hint">{{uploadingAvatar ? '头像上传中…' : '点击更换头像'}}</view>
    </view>

    <view wx:if="{{errorMessage}}" class="weui-toptips weui-toptips_warn">
      {{errorMessage}}
    </view>

    <view class="weui-cells__title">姓名</view>
    <view class="weui-cells weui-cells_after-title">
      <view class="weui-cell weui-cell_input {{errors.name ? 'weui-cell_warn' : ''}}">
        <view class="weui-cell__bd">
          <input
            class="weui-input"
            data-field="name"
            placeholder="请输入姓名"
            value="{{form.name}}"
            bindinput="handleInput"
          />
        </view>
        <view wx:if="{{errors.name}}" class="weui-cell__ft">
          <icon type="warn" size="23" color="#fa5151" />
        </view>
      </view>
    </view>
    <view wx:if="{{errors.name}}" class="weui-cells__tips error-message">
      {{errors.name}}
    </view>

    <view class="weui-cells__title">邮箱</view>
    <view class="weui-cells weui-cells_after-title">
      <view class="weui-cell weui-cell_input {{errors.email ? 'weui-cell_warn' : ''}}">
        <view class="weui-cell__bd">
          <input
            class="weui-input"
            data-field="email"
            placeholder="请输入邮箱"
            value="{{form.email}}"
            bindinput="handleInput"
          />
        </view>
        <view wx:if="{{errors.email}}" class="weui-cell__ft">
          <icon type="warn" size="23" color="#fa5151" />
        </view>
      </view>
    </view>
    <view wx:if="{{errors.email}}" class="weui-cells__tips error-message">
      {{errors.email}}
    </view>

    <view class="weui-cells__title">个人简介</view>
    <view class="weui-cells weui-cells_after-title {{errors.introduction ? 'weui-cells_warn' : ''}}">
      <view class="weui-cell">
        <view class="weui-cell__bd">
          <textarea
            class="weui-textarea introduction"
            data-field="introduction"
            maxlength="80"
            placeholder="请输入简介"
            value="{{form.introduction}}"
            bindinput="handleInput"
          />
        </view>
        <view wx:if="{{errors.introduction}}" class="weui-cell__ft">
          <icon type="warn" size="23" color="#fa5151" />
        </view>
      </view>
    </view>
    <view wx:if="{{errors.introduction}}" class="weui-cells__tips error-message">
      {{errors.introduction}}
    </view>

    <view class="weui-btn-area">
      <button
        class="weui-btn weui-btn_primary"
        loading="{{submitting || uploadingAvatar}}"
        disabled="{{submitting || uploadingAvatar}}"
        bindtap="submit"
      >
        修改
      </button>
    </view>
  </view>
</view>