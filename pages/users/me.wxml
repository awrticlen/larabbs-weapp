<view class="page user-page">
  <view class="page__bd">
    <view class="weui-cells weui-cells_after-title">
      <navigator
        wx:if="{{loggedIn && user}}"
        class="weui-cell weui-cell_access user-profile"
        url="/pages/users/edit"
      >
        <view class="weui-cell__hd avatar-wrap">
          <image
            class="avatar"
            mode="aspectFill"
            src="{{user.avatar || '/assets/images/user.png'}}"
          />
        </view>
        <view class="weui-cell__bd">
          <view class="user-name">{{user.name}}</view>
          <view class="introduction">{{user.introduction || ''}}</view>
        </view>
        <view class="weui-cell__ft weui-cell__ft_in-access"></view>
      </navigator>

      <navigator
        wx:else
        class="weui-cell weui-cell_access"
        url="/pages/auth/login"
      >
        <view class="weui-cell__hd avatar-wrap">
          <image
            class="avatar"
            mode="aspectFill"
            src="/assets/images/user.png"
          />
        </view>
        <view class="weui-cell__bd">
          <view class="user-name">未登录</view>
        </view>
        <view class="weui-cell__ft weui-cell__ft_in-access"></view>
      </navigator>

      <view class="weui-cell weui-cell_access">
        <view class="weui-cell__bd message-label">
          <text>我的消息</text>
          <view wx:if="{{unreadCount}}" class="weui-badge unread-count">{{unreadCount > 99 ? '99+' : unreadCount}}</view>
        </view>
        <view class="weui-cell__ft weui-cell__ft_in-access"></view>
      </view>
      <navigator
        wx:if="{{loggedIn && user}}"
        class="weui-cell weui-cell_access"
        url="/pages/topics/user-index?id={{user.id}}"
      >
        <view class="weui-cell__bd">我的话题</view>
        <view class="weui-cell__ft weui-cell__ft_in-access"></view>
      </navigator>
      <view wx:else class="weui-cell">
        <view class="weui-cell__bd">我的话题</view>
      </view>
      <navigator
        wx:if="{{loggedIn && user}}"
        class="weui-cell weui-cell_access"
        url="/pages/replies/user-index?id={{user.id}}"
      >
        <view class="weui-cell__bd">我的回复</view>
        <view class="weui-cell__ft weui-cell__ft_in-access"></view>
      </navigator>
      <view wx:else class="weui-cell">
        <view class="weui-cell__bd">我的回复</view>
      </view>
    </view>

    <view wx:if="{{errorMessage}}" class="logout-error">{{errorMessage}}</view>

    <view wx:if="{{loggedIn}}" class="page__bd page__bd_spacing logout">
      <button
        class="weui-btn weui-btn_warn"
        loading="{{loggingOut}}"
        disabled="{{loggingOut}}"
        bindtap="logout"
      >
        退出登录
      </button>
    </view>
  </view>
</view>