<view class="page notifications-page">
  <view class="page__bd">
    <view wx:if="{{errorMessage}}" class="weui-toptips weui-toptips_warn">
      {{errorMessage}}
    </view>

    <view wx:if="{{notifications.length}}" class="weui-panel weui-panel_access notification-panel">
      <view class="weui-panel__bd">
        <block wx:for="{{notifications}}" wx:key="id">
          <view class="weui-media-box weui-media-box_appmsg notification-item" hover-class="weui-cell_active">
            <navigator
              wx:if="{{item.userId}}"
              class="weui-media-box__hd weui-media-box__hd_in-appmsg"
              url="/pages/users/show?id={{item.userId}}"
            >
              <image class="notification-avatar weui-media-box__thumb" mode="aspectFill" src="{{item.userAvatar}}" />
            </navigator>
            <view wx:else class="weui-media-box__hd weui-media-box__hd_in-appmsg">
              <image class="notification-avatar weui-media-box__thumb" mode="aspectFill" src="{{item.userAvatar}}" />
            </view>

            <view class="weui-media-box__bd weui-media-box__bd_in-appmsg">
              <view class="notification-title">
                <navigator
                  wx:if="{{item.userId}}"
                  class="notification-user"
                  url="/pages/users/show?id={{item.userId}}"
                >{{item.userName}}</navigator>
                <text wx:else>{{item.userName}}</text>
                <text class="notification-action">评论了</text>
                <navigator
                  wx:if="{{item.topicId}}"
                  class="notification-topic"
                  url="/pages/topics/show?id={{item.topicId}}"
                >{{item.topicTitle}}</navigator>
                <text wx:else>{{item.topicTitle}}</text>
              </view>

              <rich-text
                wx:if="{{item.replyContent}}"
                class="weui-media-box__desc notification-content"
                nodes="{{item.replyContent}}"
              ></rich-text>
              <view wx:else class="weui-media-box__desc notification-content">暂无内容</view>
              <view class="weui-media-box__info notification-meta">
                <view class="weui-media-box__info__meta">{{item.createdAtText}}</view>
              </view>
            </view>
          </view>
        </block>
      </view>
    </view>

    <view wx:if="{{isLoading}}" class="weui-loadmore">
      <view class="weui-loading"></view>
      <view class="weui-loadmore__tips">加载中</view>
    </view>
    <view wx:if="{{!isLoading && !notifications.length && !errorMessage}}" class="weui-loadmore">
      <view class="weui-loadmore__tips">暂无消息</view>
    </view>
    <view wx:if="{{!isLoading && errorMessage}}" class="notification-retry">
      <button class="weui-btn weui-btn_default" bindtap="loadNotifications">重新加载</button>
    </view>
    <view wx:if="{{!isLoading && noMoreData && notifications.length}}" class="weui-loadmore weui-loadmore_line">
      <view class="weui-loadmore__tips weui-loadmore__tips_in-line">没有更多消息</view>
    </view>
  </view>
</view>