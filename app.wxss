@import "styles/weui.wxss";

page {
  min-height: 100%;
  background: #f7f8fa;
  color: #333333;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 32rpx;
}

.page-title {
  font-size: 40rpx;
  font-weight: 600;
}

.page-card {
  margin-top: 24rpx;
  padding: 32rpx;
  border-radius: 16rpx;
  background: #ffffff;
  color: #666666;
}
